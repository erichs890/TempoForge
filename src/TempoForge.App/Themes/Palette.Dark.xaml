<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta "forja": fundo de carvão frio, um único acento de brasa -->
    <SolidColorBrush x:Key="BgBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A21" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#232833" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2D3341" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#313746" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF3" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#8A92A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7A33" />
    <SolidColorBrush x:Key="AccentHotBrush" Color="#FF9A5C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A0F08" />
    <SolidColorBrush x:Key="WaveBrush" Color="#3A4154" />
    <SolidColorBrush x:Key="LoopBrush" Color="#58C4DD" />
    <SolidColorBrush x:Key="OnLoopBrush" Color="#0B1B20" />
    <SolidColorBrush x:Key="MarkerBrush" Color="#F2CC5B" />
    <SolidColorBrush x:Key="PlayheadBrush" Color="#FFFFFF" />
    <!-- Véu de realce ao passar o mouse: clareia no escuro, escurece no claro. -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#D90F1115" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA24D" Offset="0" />
        <GradientStop Color="#FF6A2A" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
