<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta clara: papel morno, o mesmo acento de brasa em tom mais fundo para o texto -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F1EC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#EAE6DF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#DDD8CF" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#D6D0C5" />
    <SolidColorBrush x:Key="TextBrush" Color="#1E1B17" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#625C53" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D9480F" />
    <SolidColorBrush x:Key="AccentHotBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A0F08" />
    <SolidColorBrush x:Key="WaveBrush" Color="#A8A195" />
    <SolidColorBrush x:Key="LoopBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="OnLoopBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MarkerBrush" Color="#8A5300" />
    <SolidColorBrush x:Key="PlayheadBrush" Color="#1E1B17" />
    <!-- Véu de realce ao passar o mouse: clareia no escuro, escurece no claro. -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#000000" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#D9F3F1EC" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9A4D" Offset="0" />
        <GradientStop Color="#F26A21" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
