<Window x:Class="TempoForge.App.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar áudio" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" UseLayoutRounding="True">
    <StackPanel Margin="22">
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16" />

        <TextBlock Text="Formato" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel x:Name="OptionsPanel">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="WavOption" Content="WAV (16 bits, sem perdas)" IsChecked="True"
                             Foreground="{StaticResource TextBrush}" Checked="OnFormatChanged" />
                <RadioButton x:Name="Mp3Option" Content="MP3" Margin="20,0,0,0"
                             Foreground="{StaticResource TextBrush}" Checked="OnFormatChanged" />
            </StackPanel>

            <StackPanel x:Name="BitratePanel" Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="False">
                <TextBlock Text="Qualidade do MP3" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="BitrateBox" Width="110" />
            </StackPanel>

            <CheckBox x:Name="RangeOnly" Content="Exportar só o trecho A-B" Margin="0,14,0,0"
                      Foreground="{StaticResource TextBrush}" />
        </StackPanel>

        <ProgressBar x:Name="Progress" Height="6" Margin="0,20,0,0" Minimum="0" Maximum="1" Visibility="Hidden"
                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceHighBrush}" BorderThickness="0" />
        <TextBlock x:Name="Status" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Fechar" Click="OnCancelClick" MinWidth="90" />
            <Button x:Name="ExportButton" Content="Exportar…" Click="OnExportClick" MinWidth="110" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
