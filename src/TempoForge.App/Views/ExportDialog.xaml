<Window x:Class="TempoForge.App.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.ExportTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="22">
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,16" />

        <TextBlock Text="{DynamicResource S.Format}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel x:Name="OptionsPanel">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="WavOption" Content="{DynamicResource S.WavOption}" IsChecked="True" Checked="OnFormatChanged" />
                <RadioButton x:Name="Mp3Option" Content="MP3" Margin="20,0,0,0" Checked="OnFormatChanged" />
            </StackPanel>

            <StackPanel x:Name="BitratePanel" Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="False">
                <TextBlock Text="{DynamicResource S.Mp3Quality}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="BitrateBox" Width="110" />
            </StackPanel>

            <CheckBox x:Name="RangeOnly" Content="{DynamicResource S.RangeOnly}" Margin="0,16,0,0" FontWeight="Normal" />
        </StackPanel>

        <ProgressBar x:Name="Progress" Margin="0,20,0,0" Minimum="0" Maximum="1" Visibility="Hidden" />
        <TextBlock x:Name="Status" Margin="0,8,0,0" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource S.Close}" Click="OnCancelClick" MinWidth="90" />
            <Button x:Name="ExportButton" Content="{DynamicResource S.Export}" Click="OnExportClick" MinWidth="110" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
