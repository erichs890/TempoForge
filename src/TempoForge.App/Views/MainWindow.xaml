<Window x:Class="TempoForge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TempoForge.App.Controls"
        Title="TempoForge" Icon="/Assets/app.ico" Width="1320" Height="780" MinWidth="1180" MinHeight="660"
        AllowDrop="True" DragEnter="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Barra lateral: recentes e biblioteca ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,10,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,16">
                    <!-- Marca: três barras em brasa, como uma onda sobre a bigorna -->
                    <Canvas Width="22" Height="22" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="1" Canvas.Top="9" Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentGradient}" />
                        <Rectangle Canvas.Left="9" Canvas.Top="2" Width="4" Height="17" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentGradient}" />
                        <Rectangle Canvas.Left="17" Canvas.Top="6" Width="4" Height="13" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentGradient}" />
                    </Canvas>
                    <TextBlock Text="TempoForge" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="RecentsTab" Content="{DynamicResource S.Recents}" IsChecked="True" GroupName="Side"
                                 Style="{StaticResource TabRadio}" />
                    <RadioButton x:Name="LibraryTab" Content="{DynamicResource S.Library}" GroupName="Side" Margin="6,0,0,0"
                                 Style="{StaticResource TabRadio}" />
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,4,0" LastChildFill="False">
                    <Button x:Name="ThemeButton" DockPanel.Dock="Left" Click="OnThemeClick" Padding="10,6"
                            ToolTip="{DynamicResource S.ThemeTip}" />
                    <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="112" ToolTip="{DynamicResource S.LanguageTip}"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="Português" Tag="pt" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                </DockPanel>

                <!-- Recentes -->
                <Grid Visibility="{Binding IsChecked, ElementName=RecentsTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource S.RecentsEmpty}"
                               TextWrapping="Wrap" Margin="4,6,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Recents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Recents}" Style="{StaticResource FileList}"
                             MouseDoubleClick="OnFileListDoubleClick" KeyDown="OnFileListKeyDown" />
                </Grid>

                <!-- Biblioteca -->
                <DockPanel Visibility="{Binding IsChecked, ElementName=LibraryTab, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,4,8">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource S.AddFolder}" Click="OnAddFolderClick" Padding="10,6" Margin="6,0,0,0"
                                ToolTip="{DynamicResource S.AddFolderTip}" />
                        <TextBox Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" ToolTip="{DynamicResource S.FilterTip}" />
                    </DockPanel>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding LibraryFolders}" Margin="0,8,4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                                            FontSize="9" Padding="6,4" Style="{StaticResource GhostButton}"
                                            ToolTip="{DynamicResource S.RemoveFolderTip}"
                                            Command="{Binding DataContext.RemoveLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryStatus}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="4,8,4,0" />
                    <ListBox ItemsSource="{Binding LibraryItems}" Style="{StaticResource FileList}"
                             MouseDoubleClick="OnFileListDoubleClick" KeyDown="OnFileListKeyDown" />
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ================= Área principal ================= -->
        <Grid Grid.Column="1" Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Título e ações -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Shortcuts}" Click="OnHelpClick" Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}" ToolTip="{DynamicResource S.ShortcutsTip}" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Export}" Click="OnExportClick" IsEnabled="{Binding IsLoaded}"
                        Margin="8,0,0,0" ToolTip="{DynamicResource S.ExportTip}" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource S.Open}" Click="OnOpenClick" ToolTip="Ctrl+O" />
                <!-- Volume geral do app -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            ToolTip="{DynamicResource S.VolumeTip}">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                    <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding Volume}" Margin="8,0" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="10" MouseDoubleClick="OnVolumeDoubleClick" />
                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource Readout}" FontSize="12" MinWidth="36"
                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>

            <!-- Forma de onda -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" ClipToBounds="True">
                <Grid>
                    <c:WaveformView x:Name="Waveform"
                                    Peaks="{Binding Peaks}" Position="{Binding Position}" Duration="{Binding Duration}"
                                    LoopA="{Binding LoopA}" LoopB="{Binding LoopB}" IsLooping="{Binding IsLooping}"
                                    Markers="{Binding Markers}"
                                    WaveBrush="{DynamicResource WaveBrush}" PlayedBrush="{DynamicResource AccentGradient}"
                                    LoopBrush="{DynamicResource LoopBrush}" MarkerBrush="{DynamicResource MarkerBrush}"
                                    PlayheadBrush="{DynamicResource PlayheadBrush}" HandleTextBrush="{DynamicResource OnLoopBrush}"
                                    Cursor="IBeam" />
                    <StackPanel x:Name="ZoomBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsEnabled="{Binding IsLoaded}" Opacity="0.9">
                        <TextBlock x:Name="ZoomLabel" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="−" Click="OnZoomOutClick" Padding="9,2" MinWidth="0"
                                ToolTip="{DynamicResource S.ZoomOutTip}" />
                        <Button Content="+" Click="OnZoomInClick" Padding="9,2" MinWidth="0" Margin="4,0,0,0"
                                ToolTip="{DynamicResource S.ZoomInTip}" />
                        <Button Content="A–B" Click="OnZoomLoopClick" Padding="9,2" MinWidth="0" Margin="4,0,0,0"
                                ToolTip="{DynamicResource S.ZoomLoopTip}" />
                        <Button Content="{DynamicResource S.ZoomAll}" Click="OnZoomResetClick" Padding="9,2" MinWidth="0" Margin="4,0,0,0"
                                ToolTip="{DynamicResource S.ZoomAllTip}" />
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="{DynamicResource S.EmptyTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource S.EmptyHint}"
                                   Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transporte -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsLoaded}">
                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource Readout}" FontSize="15" MinWidth="52"
                               VerticalAlignment="Center" />
                    <Button Content="A" Command="{Binding SetLoopACommand}" ToolTip="{DynamicResource S.LoopATip}"
                            Padding="12,6" Margin="14,0,0,0" FontWeight="SemiBold" />
                    <Button Content="B" Command="{Binding SetLoopBCommand}" ToolTip="{DynamicResource S.LoopBTip}"
                            Padding="12,6" Margin="6,0,0,0" FontWeight="SemiBold" />
                    <Button x:Name="LoopToggle" Command="{Binding ToggleLoopCommand}"
                            ToolTip="{DynamicResource S.LoopToggleTip}" Padding="12,6" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Loop" Margin="6,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Content="{DynamicResource S.Clear}" Command="{Binding ClearLoopCommand}" Padding="10,6" Margin="6,0,0,0"
                            Style="{StaticResource GhostButton}" ToolTip="{DynamicResource S.ClearTip}" />
                    <TextBlock Text="{Binding LoopText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0">
                    <Button Content="−5 s" Click="OnBackClick" IsEnabled="{Binding IsLoaded}" VerticalAlignment="Center"
                            ToolTip="{DynamicResource S.BackTip}" />
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="14,4"
                            Command="{Binding PlayPauseCommand}" IsEnabled="{Binding IsLoaded}" Content="&#xE768;"
                            ToolTip="{DynamicResource S.PlayTip}" />
                    <Button Content="+5 s" Click="OnForwardClick" IsEnabled="{Binding IsLoaded}" VerticalAlignment="Center"
                            ToolTip="{DynamicResource S.ForwardTip}" />
                </StackPanel>

                <DockPanel Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding IsLoaded}" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Readout}" FontSize="15"
                               Foreground="{DynamicResource TextDimBrush}" MinWidth="52" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                            Command="{Binding NextMarkerCommand}" ToolTip="{DynamicResource S.NextMarkerTip}" Padding="10,8" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="{DynamicResource S.AddMarker}" Command="{Binding AddMarkerCommand}"
                            ToolTip="{DynamicResource S.AddMarkerTip}" Padding="12,6" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                            Command="{Binding PreviousMarkerCommand}" ToolTip="{DynamicResource S.PrevMarkerTip}" Padding="10,8" Margin="6,0,0,0" />
                    <ScrollViewer DockPanel.Dock="Right" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  MaxWidth="230" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Markers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                            FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MarkerBrush}"
                                            Command="{Binding DataContext.JumpToMarkerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource S.MarkerChipTip}">
                                        <Button.InputBindings>
                                            <MouseBinding MouseAction="RightClick"
                                                          Command="{Binding DataContext.RemoveMarkerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </Button.InputBindings>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- Velocidade e tom -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource S.Normal}" Command="{Binding SpeedResetCommand}"
                                    Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" />
                            <TextBox DockPanel.Dock="Right" Text="{Binding SpeedInput, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ReadoutBox}" MinWidth="78"
                                     FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}"
                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                     GotKeyboardFocus="OnReadoutFocus" KeyDown="OnReadoutKeyDown" />
                            <TextBlock Text="{DynamicResource S.Speed}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Left" Content="−" Command="{Binding SpeedDownCommand}" Padding="11,3"
                                    ToolTip="{DynamicResource S.SlowerTip}" />
                            <Button DockPanel.Dock="Right" Content="+" Command="{Binding SpeedUpCommand}" Padding="11,3"
                                    ToolTip="{DynamicResource S.FasterTip}" />
                            <Slider Minimum="-2" Maximum="2" Value="{Binding SpeedSlider}" Margin="10,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="42,0,42,0">
                            <TextBlock DockPanel.Dock="Right" Text="4×" Style="{StaticResource Caption}" />
                            <TextBlock Text="{DynamicResource S.SpeedMin}" Style="{StaticResource Caption}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource S.Normal}" Command="{Binding PitchResetCommand}"
                                    Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PitchText}" Style="{StaticResource Readout}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource S.Pitch}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="−" Command="{Binding PitchDownCommand}" Padding="11,3"
                                    ToolTip="{DynamicResource S.SemitoneDownTip}" />
                            <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding Semitones}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="10,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="+" Command="{Binding PitchUpCommand}" Padding="11,3"
                                    ToolTip="{DynamicResource S.SemitoneUpTip}" />
                            <Slider Grid.Column="3" Minimum="-50" Maximum="50" Value="{Binding Cents}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="18,0,4,0" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource S.CentsTip}" />
                        </Grid>
                        <Grid Margin="42,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource S.SemitonesCaption}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="cents (±50)" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Equalizador e redução de voz -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="290" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" DataContext="{Binding Equalizer}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" Content="{DynamicResource S.Equalizer}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="{DynamicResource S.Reset}" Command="{Binding ResetCommand}"
                                    Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" Margin="6,0,0,0" />
                            <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                                      ToolTip="{DynamicResource S.PresetsTip}" />
                            <TextBlock />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Left" Width="62" Margin="0,0,10,0">
                            <TextBox Text="{Binding PreampInput, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ReadoutBox}"
                                     FontSize="11" HorizontalAlignment="Stretch"
                                     GotKeyboardFocus="OnReadoutFocus" KeyDown="OnReadoutKeyDown" />
                            <Slider Orientation="Vertical" Height="92" Minimum="-15" Maximum="15" Value="{Binding PreampDb}"
                                    TickFrequency="0.5" IsSnapToTickEnabled="True" HorizontalAlignment="Center" Margin="0,4"
                                    PreviewMouseDoubleClick="OnEqSliderDoubleClick" ToolTip="{DynamicResource S.DoubleClickReset}" />
                            <TextBlock Text="{DynamicResource S.Preamp}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource OutlineBrush}" Margin="0,4,6,4" />

                        <ItemsControl ItemsSource="{Binding Bands}" IsEnabled="{Binding IsEnabled}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Text="{Binding GainInput, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ReadoutBox}" FontSize="11"
                                                 HorizontalAlignment="Center" MinWidth="52"
                                                 GotKeyboardFocus="OnReadoutFocus" KeyDown="OnReadoutKeyDown" />
                                        <Slider Orientation="Vertical" Height="92" Minimum="-15" Maximum="15" Value="{Binding GainDb}"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True" HorizontalAlignment="Center" Margin="0,4"
                                                PreviewMouseDoubleClick="OnEqSliderDoubleClick" ToolTip="{DynamicResource S.DoubleClickReset}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" DataContext="{Binding VocalReducer}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsEnabled}" Content="{DynamicResource S.ReduceVocals}"
                                  ToolTip="{DynamicResource S.ReduceVocalsTip}" />
                        <StackPanel IsEnabled="{Binding IsEnabled}" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Style="{StaticResource Readout}" FontSize="11" />
                                <TextBlock Text="{DynamicResource S.Intensity}" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Amount}" Margin="0,0,0,6" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LowCutText}" Style="{StaticResource Readout}" FontSize="11" />
                                <TextBlock Text="{DynamicResource S.KeepLows}" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <Slider Minimum="20" Maximum="400" Value="{Binding LowCut}" Margin="0,0,0,6"
                                    TickFrequency="10" IsSnapToTickEnabled="True" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HighCutText}" Style="{StaticResource Readout}" FontSize="11" />
                                <TextBlock Text="{DynamicResource S.KeepHighs}" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <Slider Minimum="1000" Maximum="16000" Value="{Binding HighCut}"
                                    TickFrequency="500" IsSnapToTickEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Aviso mostrado enquanto um arquivo é arrastado sobre a janela -->
        <Border x:Name="DropHint" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="16" Margin="24">
                <TextBlock Text="{DynamicResource S.DropToOpen}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Border>
    </Grid>
</Window>
