<Window x:Class="TempoForge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TempoForge.App.Controls"
        Title="TempoForge" Width="1320" Height="780" MinWidth="1180" MinHeight="660"
        AllowDrop="True" DragEnter="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral: recentes e biblioteca -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="14,18,14,14">
                <TextBlock DockPanel.Dock="Top" Text="TempoForge" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="4,0,0,14" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="RecentsTab" Content="Recentes" IsChecked="True" GroupName="Side"
                                 Style="{StaticResource TabRadio}" />
                    <RadioButton x:Name="LibraryTab" Content="Biblioteca" GroupName="Side" Margin="6,0,0,0"
                                 Style="{StaticResource TabRadio}" />
                </StackPanel>

                <!-- Recentes -->
                <Grid Visibility="{Binding IsChecked, ElementName=RecentsTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Os arquivos que você abrir aparecem aqui. Também dá para arrastar um arquivo para a janela."
                               TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="4,6,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Recents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Recents}" Style="{StaticResource FileList}"
                             MouseDoubleClick="OnFileListDoubleClick" KeyDown="OnFileListKeyDown" />
                </Grid>

                <!-- Biblioteca -->
                <DockPanel Visibility="{Binding IsChecked, ElementName=LibraryTab, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="+ Pasta" Click="OnAddFolderClick" Padding="10,5" Margin="6,0,0,0"
                                ToolTip="Adicionar uma pasta de músicas" />
                        <TextBox Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" ToolTip="Filtrar por nome" />
                    </DockPanel>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding LibraryFolders}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,1" FontSize="10"
                                            ToolTip="Remover esta pasta da biblioteca (não apaga arquivos)"
                                            Command="{Binding DataContext.RemoveLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryStatus}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}" Margin="4,8,0,0" />
                    <ListBox ItemsSource="{Binding LibraryItems}" Style="{StaticResource FileList}"
                             MouseDoubleClick="OnFileListDoubleClick" KeyDown="OnFileListKeyDown" />
                </DockPanel>
            </DockPanel>
        </Border>

    <Grid Grid.Column="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Atalhos" Click="OnHelpClick" Margin="8,0,0,0"
                    ToolTip="Ver os atalhos de teclado  (F1)" />
            <Button DockPanel.Dock="Right" Content="Exportar…" Click="OnExportClick" IsEnabled="{Binding IsLoaded}"
                    Margin="8,0,0,0" ToolTip="Salvar o áudio com os ajustes atuais  (Ctrl+E)" />
            <Button DockPanel.Dock="Right" Content="Abrir arquivo…" Click="OnOpenClick" ToolTip="Ctrl+O" />
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" ClipToBounds="True">
            <c:WaveformView x:Name="Waveform"
                            Peaks="{Binding Peaks}" Position="{Binding Position}" Duration="{Binding Duration}"
                            LoopA="{Binding LoopA}" LoopB="{Binding LoopB}" IsLooping="{Binding IsLooping}"
                            Markers="{Binding Markers}"
                            WaveBrush="{StaticResource SurfaceHighBrush}" PlayedBrush="{StaticResource AccentBrush}"
                            LoopBrush="{StaticResource LoopBrush}" MarkerBrush="{StaticResource MarkerBrush}"
                            Cursor="IBeam" />
        </Border>

        <DockPanel Grid.Row="2" Margin="2,8,2,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Foreground="{StaticResource TextDimBrush}" />
            <TextBlock Text="{Binding PositionText}" />
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="−5 s" Click="OnBackClick" IsEnabled="{Binding IsLoaded}" Margin="0,0,8,0" />
            <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" MinWidth="110"
                    Command="{Binding PlayPauseCommand}" IsEnabled="{Binding IsLoaded}" Content="Tocar" />
            <Button Content="+5 s" Click="OnForwardClick" IsEnabled="{Binding IsLoaded}" Margin="8,0,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,14,0,0" IsEnabled="{Binding IsLoaded}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="A" Command="{Binding SetLoopACommand}" ToolTip="Marcar início do loop aqui  ( [ )" Padding="12,5" />
                <Button Content="B" Command="{Binding SetLoopBCommand}" ToolTip="Marcar fim do loop aqui  ( ] )" Padding="12,5" Margin="6,0,0,0" />
                <Button x:Name="LoopToggle" Content="Loop" Command="{Binding ToggleLoopCommand}" ToolTip="Ligar ou desligar a repetição  ( \ )" Padding="12,5" Margin="6,0,0,0" />
                <Button Content="Limpar" Command="{Binding ClearLoopCommand}" Padding="12,5" Margin="6,0,0,0" />
                <TextBlock Text="{Binding LoopText}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ItemsControl ItemsSource="{Binding Markers}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                    Foreground="{StaticResource MarkerBrush}"
                                    Command="{Binding DataContext.JumpToMarkerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Clique para ir até aqui; botão direito para remover">
                                <Button.InputBindings>
                                    <MouseBinding MouseAction="RightClick"
                                                  Command="{Binding DataContext.RemoveMarkerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </Button.InputBindings>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="◀" Command="{Binding PreviousMarkerCommand}" ToolTip="Marcador anterior  ( , )" Padding="10,5" />
                <Button Content="+ Marcador" Command="{Binding AddMarkerCommand}" ToolTip="Adicionar marcador aqui  ( M )" Padding="12,5" Margin="6,0,0,0" />
                <Button Content="▶" Command="{Binding NextMarkerCommand}" ToolTip="Próximo marcador  ( . )" Padding="10,5" Margin="6,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Velocidade" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                    <Button Grid.Column="1" Content="−" Command="{Binding SpeedDownCommand}" Padding="10,4" />
                    <Slider Grid.Column="2" Minimum="-2" Maximum="2" Value="{Binding SpeedSlider}"
                            Margin="10,0" VerticalAlignment="Center" Focusable="False"
                            IsMoveToPointEnabled="True" />
                    <Button Grid.Column="3" Content="+" Command="{Binding SpeedUpCommand}" Padding="10,4" />
                    <TextBlock Grid.Column="4" Text="{Binding SpeedText}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Content="Normal" Command="{Binding SpeedResetCommand}" Margin="10,0,0,0" Padding="10,4" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tom" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                    <Button Grid.Column="1" Content="−" Command="{Binding PitchDownCommand}" Padding="10,4" />
                    <Slider Grid.Column="2" Minimum="-12" Maximum="12" Value="{Binding Semitones}"
                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                            Margin="10,0" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True" />
                    <Button Grid.Column="3" Content="+" Command="{Binding PitchUpCommand}" Padding="10,4" />
                    <TextBlock Grid.Column="4" Text="Cents" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" />
                    <Slider Grid.Column="5" Minimum="-50" Maximum="50" Value="{Binding Cents}"
                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                            Margin="10,0" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True" />
                    <TextBlock Grid.Column="6" Text="{Binding PitchText}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="7" Content="Normal" Command="{Binding PitchResetCommand}" Margin="10,0,0,0" Padding="10,4" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="EqualizerPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12"
                    DataContext="{Binding Equalizer}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" Content="Equalizador"
                                  Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Focusable="False" />
                        <Button DockPanel.Dock="Right" Content="Zerar" Command="{Binding ResetCommand}" Padding="10,4" Margin="8,0,0,0" />
                        <ComboBox DockPanel.Dock="Right" Width="190" ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Focusable="False" />
                        <TextBlock />
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Left" Width="64" Margin="0,0,12,0">
                        <TextBlock Text="{Binding PreampText}" FontSize="11" HorizontalAlignment="Center" />
                        <Slider Orientation="Vertical" Height="96" Minimum="-15" Maximum="15" Value="{Binding PreampDb}"
                                TickFrequency="0.5" IsSnapToTickEnabled="True" HorizontalAlignment="Center"
                                Margin="0,4" Focusable="False" IsMoveToPointEnabled="True" />
                        <TextBlock Text="Pré-amp" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Bands}" IsEnabled="{Binding IsEnabled}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding GainText}" FontSize="11" HorizontalAlignment="Center" />
                                    <Slider Orientation="Vertical" Height="96" Minimum="-15" Maximum="15" Value="{Binding GainDb}"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" HorizontalAlignment="Center"
                                            Margin="0,4" Focusable="False" IsMoveToPointEnabled="True" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <StackPanel x:Name="SidePanel" Grid.Column="1" Width="270" Margin="12,0,0,0">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12"
                        DataContext="{Binding VocalReducer}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsEnabled}" Content="Reduzir voz"
                                  Foreground="{StaticResource TextBrush}" Focusable="False"
                                  ToolTip="Atenua o que está no centro do estéreo. Funciona melhor em gravações estéreo de estúdio." />
                        <StackPanel IsEnabled="{Binding IsEnabled}" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontSize="11" />
                                <TextBlock Text="Intensidade" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Amount}" Margin="0,2,0,8"
                                    Focusable="False" IsMoveToPointEnabled="True" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LowCutText}" FontSize="11" />
                                <TextBlock Text="Preservar graves abaixo de" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            </DockPanel>
                            <Slider Minimum="20" Maximum="400" Value="{Binding LowCut}" Margin="0,2,0,8"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Focusable="False" IsMoveToPointEnabled="True" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HighCutText}" FontSize="11" />
                                <TextBlock Text="Preservar agudos acima de" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            </DockPanel>
                            <Slider Minimum="1000" Maximum="16000" Value="{Binding HighCut}" Margin="0,2,0,0"
                                    TickFrequency="500" IsSnapToTickEnabled="True" Focusable="False" IsMoveToPointEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

        <!-- Aviso mostrado enquanto um arquivo é arrastado sobre a janela -->
        <Border x:Name="DropHint" Grid.ColumnSpan="2" Background="#CC14161B" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="14" Margin="24">
                <TextBlock Text="Solte para abrir" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Border>
    </Grid>
</Window>
