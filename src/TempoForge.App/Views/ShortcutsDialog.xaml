<Window x:Class="TempoForge.App.Views.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atalhos de teclado" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="22">
        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="5" Padding="8,3"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Fechar" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90"
                Margin="0,16,0,0" Click="OnCloseClick" />
    </StackPanel>
</Window>
